ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# Paste the Atlas driver connection string here, including the database user credentials.
MONGODB_URI=
MONGODB_DB=cr7
API_PORT=3001
HOST=127.0.0.1
# Only list IPs of reverse proxies you control that overwrite X-Forwarded-For.
TRUSTED_PROXY_IPS=
# Set NODE_ENV=production behind HTTPS to enable Secure admin cookies.

# Exact frontend origins, comma-separated. Defaults to localhost on ports 5173 and 5174.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
